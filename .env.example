DEBUG=False

# Generate a SECRET_KEY using: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-generated-secret-key-do-not-commit-real-key

DB_ENGINE=django.db.backends.postgresql
DB_NAME=e_hospital
DB_USER=postgres
DB_PASSWORD=your-secure-password
DB_HOST=db
DB_PORT=5432

REDIS_URL=redis://redis:6379/0

# For development, allow localhost. For production, specify your domain
ALLOWED_HOSTS=localhost,127.0.0.1

# Update with your production domain and frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Configuration - Update with your email service
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
SMTP_EMAIL=your-email@example.com
SMTP_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Twilio Configuration (optional)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key

# Security Settings
SECURE_HSTS_SECONDS=31536000
USE_POSTGRES=True
DJANGO_LOG_LEVEL=INFO
