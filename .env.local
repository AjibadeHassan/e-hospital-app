DEBUG=True
SECRET_KEY=django-insecure-your-secret-key-change-this-in-production-12345

# Database Configuration
DB_ENGINE=django.db.backends.postgresql
DB_NAME=e_hospital
DB_USER=postgres
DB_PASSWORD=postgres
DB_HOST=db
DB_PORT=5432
USE_POSTGRES=True

# Redis Configuration
REDIS_URL=redis://redis:6379/0

# Django Configuration
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://frontend:3000

# Email Configuration (Gmail Example)
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
DEFAULT_FROM_EMAIL=noreply@e-hospital.com

# External APIs (Twilio for SMS)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# Logging
DJANGO_LOG_LEVEL=INFO
